# Copy to .env and fill in values. NEVER commit .env (real credentials).
# All keys optional — defaults documented in src/core/config/.

TTS_BACKEND=
TTS_VOICE=
VIDEOS_ROOT=
DATA_ROOT=
FFMPEG_PATH=

# ---- MiniMax（收费语音合成，定稿后换成品音色才用）-------------------------
# 草稿阶段用免费后端（edge），定稿后再跑一次：
#   vagent tts run <slug> --backend minimax --fresh
# 不要把 TTS_BACKEND 设成 minimax——那会让每次草稿都计费。
#
# MINIMAX_API_KEY   接口密钥（平台 > 账户管理 > 接口密钥）。缺它 minimax 后端直接报错
# MINIMAX_VOICE     定稿音色 id；只影响 minimax，默认 male-qn-jingying（精英青年）
#                   中文可选：male-qn-jingying / male-qn-qingse / male-qn-badao /
#                   female-yujie / female-tianmei / Chinese (Mandarin)_Gentleman /
#                   Chinese (Mandarin)_Reliable_Executive / Chinese (Mandarin)_Radio_Host
#                   全表 https://platform.minimaxi.com/docs/faq/system-voice-id
# MINIMAX_MODEL     默认 speech-2.6-hd；可选 speech-2.8-hd / speech-2.8-turbo /
#                   speech-2.6-turbo / speech-02-hd / speech-02-turbo /
#                   speech-01-hd / speech-01-turbo（turbo 更便宜，hd 音质更好）
# MINIMAX_SPEED     语速 [0.5, 2]，默认 1
# MINIMAX_BASE_URL  默认国内站 https://api.minimaxi.com；国际站 https://api.minimax.io
# MINIMAX_GROUP_ID  仅老账号需要；设了才会作为 GroupId 查询参数带上
MINIMAX_API_KEY=
MINIMAX_VOICE=
MINIMAX_MODEL=
MINIMAX_SPEED=
MINIMAX_BASE_URL=
MINIMAX_GROUP_ID=
